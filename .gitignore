# ESP-IDF build outputs
build/
build_*/
sdkconfig
sdkconfig.old
sdkconfig.sdxfer
dependencies.lock

# IDF managed components cache
managed_components/

# Python
__pycache__/
*.pyc
.venv/

# Cached raw tile downloads + generated blob (tools/fetch_tiles.py)
tools/.tile_png_cache/
tools/tiles.bin
/tiles.bin

# IDE
.vscode/
.idea/

# Reference photos/screenshots dropped in the working tree (e.g. hardware
# pinout photos taken during debugging) -- not project assets, not meant
# to be committed. Intentional image assets go under assets/ instead.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.heic
*.tif
*.tiff
!assets/**
