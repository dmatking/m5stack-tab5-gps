# ESP-IDF build outputs
build/
build_*/
sdkconfig
sdkconfig.old
sdkconfig.sdxfer
dependencies.lock

# IDF managed components cache
managed_components/

# wifi_prov's nested captive-portal component, copied into components/ at
# CMake configure time (see root CMakeLists.txt) -- regenerated from the
# components/wifi_prov submodule every configure, not meant to be committed.
/components/nordesems__esp-captive-portal/

# Python
__pycache__/
*.pyc
.venv/

# IDE
.vscode/
.idea/

# Design hand-off zips + their unpacked contents, and mockup image blobs --
# large, regenerable/source-controlled-elsewhere working files dropped in
# the tree during design work, never meant to be committed (see the
# untracked-files sweep this was added from). Tile-generation tooling and
# working data (fetch_tiles.py, arcgis_bundle_to_sd.py, gisdata/, tiles*)
# moved to their own repo, m5stack-tab5-map-tiles -- nothing in this repo
# produces that output anymore, so those ignore rules moved with them.
/M4Stack GPS Handheld*.zip
/lvgl_design_extract/
/lvgl_design_extract2/
/mockups_rgb565/

# Reference photos/screenshots dropped in the working tree (e.g. hardware
# pinout photos taken during debugging) -- not project assets, not meant
# to be committed. Intentional image assets go under assets/ instead.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.heic
*.tif
*.tiff
!assets/**
