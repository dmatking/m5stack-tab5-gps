# ESP-IDF build outputs
build/
build_*/
sdkconfig
sdkconfig.old
sdkconfig.sdxfer
dependencies.lock

# IDF managed components cache
managed_components/

# wifi_prov's nested captive-portal component, copied into components/ at
# CMake configure time (see root CMakeLists.txt) -- regenerated from the
# components/wifi_prov submodule every configure, not meant to be committed.
/components/nordesems__esp-captive-portal/

# Python
__pycache__/
*.pyc
.venv/

# Cached raw tile downloads + generated blob (tools/fetch_tiles.py)
tools/.tile_png_cache/
tools/tiles.bin
/tiles.bin

# SD-card tile shard output (tools/fetch_tiles.py --target sd) -- large
# regenerable binary blobs, same reasoning as tiles.bin above.
tiles_sd_out/
tools_sd_test/
tools_sd_test_single/
tiles_sd_*.bin

# IDE
.vscode/
.idea/

# Design hand-off zips + their unpacked contents, working GIS data, mockup
# image blobs, and misc tile scratch data -- large, regenerable/source-
# controlled-elsewhere working files dropped in the tree during design/tile
# work, never meant to be committed (see the untracked-files sweep this was
# added from).
/M4Stack GPS Handheld*.zip
/gisdata/
/lvgl_design_extract/
/lvgl_design_extract2/
/mockups_rgb565/
/tiles/

# Reference photos/screenshots dropped in the working tree (e.g. hardware
# pinout photos taken during debugging) -- not project assets, not meant
# to be committed. Intentional image assets go under assets/ instead.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.heic
*.tif
*.tiff
!assets/**
